---
import { Image, getImage } from 'astro:assets';
import { CATEGORY_LABELS } from '../data/categories';
import { fileName, permissions, type Project } from '../lib/projects';

interface Props {
  project: Project;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const { title, summary, cover, video, tags, date, version, category } = project.data;
const glyphs = '01<>/{}[]#*+=~'.repeat(40);
const poster = video && cover ? (await getImage({ src: cover, width: 720, format: 'webp' })).src : undefined;
---

<a class:list={['card', { compact }]} href={`/projects/${project.id}/`} data-category={category}>
  <div class="media">
    {
      video ? (
        <video src={video} poster={poster} muted loop playsinline preload="none" data-autoplay aria-hidden="true" />
      ) : cover ? (
        <Image src={cover} alt="" widths={[360, 720]} sizes="(max-width: 700px) 100vw, 360px" loading="lazy" />
      ) : (
        <div class="placeholder" aria-hidden="true">
          <span class="noise">{glyphs}</span>
          <span class="mark">{title.slice(0, 2).toLowerCase()}</span>
        </div>
      )
    }
  </div>
  <div class="body">
    <div class="meta d">
      {permissions(project)}&nbsp;&nbsp;{version ?? CATEGORY_LABELS[category]}&nbsp;&nbsp;{date.getFullYear()}
    </div>
    <h3 class="name"><span class="glitch">{fileName(project)}</span></h3>
    <p class="title">{title}</p>
    {!compact && <p class="summary d">{summary}</p>}
    {
      !compact && tags.length > 0 && (
        <div class="tags">
          {tags.slice(0, 4).map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }
  </div>
</a>

<style>
  .card {
    --px: 4px;
    --frame: var(--line);
    display: flex;
    flex-direction: column;
    position: relative;
    margin: var(--px);
    background: var(--panel);
    border: 0;
    border-radius: 0;
    overflow: visible;
    color: var(--txt);
    box-shadow:
      0 calc(var(--px) * -1) 0 0 var(--frame),
      0 var(--px) 0 0 var(--frame),
      calc(var(--px) * -1) 0 0 0 var(--frame),
      var(--px) 0 0 0 var(--frame),
      0 0 0 0 transparent;
    transition: transform 0.18s steps(3), box-shadow 0.18s steps(2);
  }
  .card::before,
  .card::after {
    content: '';
    position: absolute;
    width: var(--px);
    height: var(--px);
    background: var(--frame);
    pointer-events: none;
  }
  .card::before { top: 0; left: 0; }
  .card::after { right: 0; bottom: 0; }
  .card:hover {
    --frame: var(--acc);
    text-decoration: none;
    transform: translate(calc(var(--px) * -1), calc(var(--px) * -2));
    box-shadow:
      0 calc(var(--px) * -1) 0 0 var(--frame),
      0 var(--px) 0 0 var(--frame),
      calc(var(--px) * -1) 0 0 0 var(--frame),
      var(--px) 0 0 0 var(--frame),
      calc(var(--px) * 3) calc(var(--px) * 4) 0 0 color-mix(in srgb, var(--acc2) 55%, transparent);
  }
  .card:hover .glitch { animation: glitch 0.35s steps(2) 2; }
  .media { aspect-ratio: 16 / 9; background: #0d120f; overflow: hidden; }
  .compact .media { aspect-ratio: 16 / 10; }
  .media :global(img), .media video { width: 100%; height: 100%; object-fit: cover; object-position: top; filter: saturate(0.85); transition: filter 0.3s, transform 0.4s; display: block; }
  .card:hover .media :global(img), .card:hover .media video { filter: saturate(1); transform: scale(1.03); }
  .placeholder { position: relative; height: 100%; display: grid; place-items: center; overflow: hidden; }
  .noise {
    position: absolute;
    inset: 0;
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 3px;
    word-break: break-all;
    color: var(--acc);
    opacity: 0.18;
  }
  .mark { position: relative; font-family: var(--display); font-size: 56px; color: var(--acc); letter-spacing: -2px; }
  .body {
    padding: 18px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    background: repeating-linear-gradient(90deg, var(--frame) 0 var(--px), transparent var(--px) calc(var(--px) * 2)) top / 100% var(--px) no-repeat;
  }
  .meta { font-size: 11px; }
  .name { font-family: var(--mono); font-size: 15px; margin: 4px 0 0; }
  .glitch { display: inline-block; }
  .title { margin: 0; font-size: 13px; color: var(--dim); }
  .summary { margin: 6px 0 0; font-size: 13px; line-height: 1.6; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; padding-top: 12px; }
  .tags .tag { border: 0; border-radius: 0; box-shadow: 0 -2px 0 0 var(--line), 0 2px 0 0 var(--line), -2px 0 0 0 var(--line), 2px 0 0 0 var(--line); margin: 2px; }
  .card:hover .tags .tag { color: var(--txt); }
</style>
