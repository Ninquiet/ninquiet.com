<div class="level" id="level-transition" aria-hidden="true">
  <canvas class="blocks"></canvas>
  <div class="hud">
    <p class="kicker" data-kicker>LOADING STAGE</p>
    <p class="title" data-title></p>
    <div class="bar" data-bar><span></span></div>
  </div>
</div>

<script>
  import { LevelTransition } from '../lib/levelTransition';

  const root = document.getElementById('level-transition');
  if (root) {
    new LevelTransition({
      root,
      canvas: root.querySelector('canvas')!,
      kicker: root.querySelector('[data-kicker]')!,
      title: root.querySelector('[data-title]')!,
      bar: root.querySelector('[data-bar]')!,
    }).attach();
  }
</script>

<style>
  .level {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
    visibility: hidden;
  }
  .level[data-state] { visibility: visible; pointer-events: all; }
  :global(:root[data-level-enter]) .level { visibility: visible; background: var(--bg); }
  .level[data-state='revealing'] { background: transparent; }
  .blocks { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated; }
  .hud {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 18px;
    font-family: 'Press Start 2P', monospace;
    text-align: center;
    padding: 24px;
    opacity: 0;
  }
  .level[data-state='loading'] .hud { opacity: 1; }
  .level[data-state='loading'] { background: var(--bg); }
  .kicker { margin: 0; font-size: 11px; color: var(--acc2); letter-spacing: 2px; animation: blink 0.5s steps(1) infinite; }
  .title { margin: 0; font-size: clamp(14px, 3vw, 22px); color: var(--acc); max-width: 90vw; overflow-wrap: anywhere; }
  .bar {
    --progress: 0;
    width: min(320px, 70vw);
    height: 18px;
    padding: 3px;
    box-shadow: 0 -3px 0 0 var(--acc), 0 3px 0 0 var(--acc), -3px 0 0 0 var(--acc), 3px 0 0 0 var(--acc);
  }
  .bar span {
    display: block;
    height: 100%;
    width: calc(var(--progress) * 100%);
    background: repeating-linear-gradient(90deg, var(--acc) 0 12px, transparent 12px 16px);
  }
</style>
